<Window x:Class="TwMarketWidget.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:TwMarketWidget.ViewModels"
        xmlns:ctl="clr-namespace:TwMarketWidget.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="台股即時報價"
        Height="520" Width="1240"
        MinHeight="120" MinWidth="280"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="True"
        Topmost="{Binding AlwaysOnTop}"
        FontFamily="Microsoft JhengHei UI"
        d:DataContext="{d:DesignInstance vm:MainViewModel}">

    <!-- 懸浮外框：底色可調透明度，文字與數字維持實心 -->
    <Border CornerRadius="10" BorderThickness="1" BorderBrush="{StaticResource GlassBorderBrush}">
        <Border.Background>
            <SolidColorBrush Color="{StaticResource BackgroundColor}"
                             Opacity="{Binding BackgroundOpacity}" />
        </Border.Background>

        <Grid Margin="10,6,10,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 標題列：整條可拖曳移動視窗 -->
            <DockPanel Grid.Row="0" Background="Transparent"
                       MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <TextBlock Text="台股即時報價" FontSize="14" FontWeight="SemiBold" />
                <TextBlock Style="{StaticResource MutedText}" Margin="10,2,0,0"
                           Text="證交所 MIS / 期交所 MIS"
                           Visibility="{Binding FullMode, Converter={StaticResource BoolToVisibility}}" />

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource CaptionButton}" Width="40"
                            Content="{Binding ModeButtonText}" Command="{Binding ToggleModeCommand}"
                            ToolTip="切換精簡／完整介面" />
                    <Button Style="{StaticResource CaptionButton}" Content="—"
                            ToolTip="最小化" Click="Minimize_Click" />
                    <Button Style="{StaticResource CaptionButton}" Content="✕"
                            ToolTip="關閉" Click="Close_Click" />
                </StackPanel>
            </DockPanel>

            <!-- 工具列 -->
            <DockPanel Grid.Row="1" Margin="0,6,0,8"
                       Visibility="{Binding FullMode, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource MutedText}" Text="透明度" Margin="0,0,6,0" />
                    <Slider Width="110" Minimum="0.15" Maximum="1" VerticalAlignment="Center"
                            IsMoveToPointEnabled="True"
                            ToolTip="拖到最左邊幾乎全透明，最右邊為不透明"
                            Value="{Binding BackgroundOpacity, Mode=TwoWay}" />
                    <TextBlock Style="{StaticResource MutedText}" Margin="8,0,0,0" Width="34"
                               FontFamily="{StaticResource NumericFont}"
                               Text="{Binding BackgroundOpacity, StringFormat={}{0:P0}}" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Style="{StaticResource MutedText}" Text="更新(秒)" Margin="0,0,4,0" />
                    <TextBox Width="42" TextAlignment="Center"
                             Text="{Binding RefreshSeconds, UpdateSourceTrigger=LostFocus}" />
                    <CheckBox Content="釘在最上層" IsChecked="{Binding AlwaysOnTop}" Margin="12,0,4,0" />
                    <Button Content="立即更新" Command="{Binding RefreshCommand}" />
                </StackPanel>
            </DockPanel>

            <!-- 精簡模式：代號、名稱、當日走勢秒線、現價 -->
            <ItemsControl Grid.Row="2" ItemsSource="{Binding Rows}" Margin="0,2,0,0"
                          Visibility="{Binding CompactMode, Converter={StaticResource BoolToVisibility}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Height="26" ToolTip="{Binding ToolTipText}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="54" />
                                <ColumnDefinition Width="76" />
                                <ColumnDefinition Width="*" MinWidth="60" />
                                <ColumnDefinition Width="86" />
                                <ColumnDefinition Width="66" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="{Binding Code}"
                                       Style="{StaticResource TextCell}" Margin="2,0,0,0"
                                       FontFamily="{StaticResource NumericFont}" FontSize="12" />

                            <TextBlock Grid.Column="1" Text="{Binding Name}"
                                       Style="{StaticResource TextCell}" Margin="4,0,0,0"
                                       FontSize="12" TextTrimming="CharacterEllipsis" />

                            <ctl:Sparkline Grid.Column="2" Margin="6,4" MinHeight="18"
                                           Series="{Binding Series}"
                                           Baseline="{Binding PrevClose}"
                                           SessionStart="{Binding SessionStart}"
                                           SessionEnd="{Binding SessionEnd}"
                                           UpBrush="{StaticResource UpBrush}"
                                           DownBrush="{StaticResource DownBrush}"
                                           FlatBrush="{StaticResource MutedTextBrush}" />

                            <TextBlock Grid.Column="3" Style="{StaticResource DirectionalCell}"
                                       FontWeight="SemiBold" Margin="0,0,4,0"
                                       Text="{Binding Last, Converter={StaticResource Number}, ConverterParameter='0.00'}" />

                            <TextBlock Grid.Column="4" Style="{StaticResource DirectionalCell}"
                                       Margin="0,0,4,0" FontSize="12"
                                       ToolTip="今日漲跌幅"
                                       Text="{Binding ChangePercent, Converter={StaticResource SignedNumber}, ConverterParameter='0.00|%'}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- 報價表 -->
            <Border Grid.Row="3" BorderBrush="{StaticResource GlassBorderBrush}"
                    BorderThickness="1" CornerRadius="6" ClipToBounds="True"
                    Visibility="{Binding FullMode, Converter={StaticResource BoolToVisibility}}">
                <DataGrid Style="{StaticResource QuoteGrid}"
                          ItemsSource="{Binding Rows}"
                          SelectedItem="{Binding SelectedRow}">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="類別" Width="48"
                                                HeaderStyle="{StaticResource LeftHeader}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding KindLabel}" Style="{StaticResource TextCell}"
                                               Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="代號" Width="68"
                                                HeaderStyle="{StaticResource LeftHeader}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Code}" Style="{StaticResource TextCell}"
                                               FontFamily="{StaticResource NumericFont}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="名稱" Width="132"
                                                HeaderStyle="{StaticResource LeftHeader}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource TextCell}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding ToolTipText}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="成交" Width="98">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Style="{StaticResource DirectionalCell}" FontWeight="SemiBold"
                                               Text="{Binding Last, Converter={StaticResource Number}, ConverterParameter='0.00'}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="漲跌" Width="86">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Style="{StaticResource DirectionalCell}"
                                               Text="{Binding Change, Converter={StaticResource SignedNumber}, ConverterParameter='0.00'}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="幅度%" Width="76">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Style="{StaticResource DirectionalCell}"
                                               Text="{Binding ChangePercent, Converter={StaticResource SignedNumber}, ConverterParameter='0.00'}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="買進" Width="94">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Style="{StaticResource NumericCell}"
                                               Text="{Binding Bid, Converter={StaticResource Number}, ConverterParameter='0.00'}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="賣出" Width="94">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Style="{StaticResource NumericCell}"
                                               Text="{Binding Ask, Converter={StaticResource Number}, ConverterParameter='0.00'}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="開盤" Width="94">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Style="{StaticResource NumericCell}"
                                               Text="{Binding Open, Converter={StaticResource Number}, ConverterParameter='0.00'}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="最高" Width="94">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Style="{StaticResource NumericCell}"
                                               Text="{Binding High, Converter={StaticResource Number}, ConverterParameter='0.00'}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="最低" Width="94">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Style="{StaticResource NumericCell}"
                                               Text="{Binding Low, Converter={StaticResource Number}, ConverterParameter='0.00'}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="昨收/參考" Width="98">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Style="{StaticResource NumericCell}"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               Text="{Binding PrevClose, Converter={StaticResource Number}, ConverterParameter='0.00'}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="總量" Width="88">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Style="{StaticResource NumericCell}"
                                               Text="{Binding Volume, Converter={StaticResource Number}, ConverterParameter='#,##0'}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="時間" Width="*" MinWidth="84">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Style="{StaticResource NumericCell}"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               Text="{Binding TradeTimeText}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- 自選清單編輯 -->
            <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,8,0,0"
                        Visibility="{Binding FullMode, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Style="{StaticResource MutedText}" Text="新增" Margin="0,0,6,0" />
                <TextBox Width="90" Text="{Binding NewCode, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="股票代號 2330、指數 t00／o00、期貨 TX／MTX">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding AddCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
                <ComboBox Width="86" Margin="6,0" ItemsSource="{Binding MarketOptions}"
                          SelectedItem="{Binding NewMarket}" />
                <Button Content="加入" Command="{Binding AddCommand}" />
                <Button Content="刪除" Command="{Binding RemoveCommand}" Margin="12,0,2,0" />
                <Button Content="上移" Command="{Binding MoveUpCommand}" />
                <Button Content="下移" Command="{Binding MoveDownCommand}" />
            </StackPanel>

            <!-- 狀態列 -->
            <DockPanel Grid.Row="5" Margin="0,8,0,0">
                <TextBlock Style="{StaticResource MutedText}" Text="{Binding StatusText}"
                           Visibility="{Binding FullMode, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Style="{StaticResource MutedText}" Margin="10,0,0,0"
                           Foreground="{StaticResource ErrorBrush}"
                           Text="{Binding ErrorText}"
                           TextTrimming="CharacterEllipsis"
                           Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Style="{StaticResource MutedText}" DockPanel.Dock="Right"
                           HorizontalAlignment="Right" Text="更新中…" Margin="0,0,18,0"
                           Foreground="{StaticResource AccentBrush}"
                           Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
            </DockPanel>
        </Grid>
    </Border>
</Window>
